
cat > .gitignore <<'EOF'
# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Secrets and local configuration
.env
.env.*
!.env.example

# macOS and editors
.DS_Store
.vscode/
.idea/

# Downloaded documents and generated data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Evaluation outputs
evals/reports/*
!evals/reports/.gitkeep

# Model artifacts
models/
*.safetensors
*.gguf
EOF
